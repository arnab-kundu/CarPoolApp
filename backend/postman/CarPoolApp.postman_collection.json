{
  "info": {
    "name": "CarPoolApp Backend",
    "description": "All eight routes implemented in backend/src. Auth and ride routes return 503 for valid inputs until integrations are configured. Sample IDs, OTP, and refresh token are placeholders; no login or token capture is performed. Run against a local server. Validation examples expect 400. Default baseUrl excludes the /v1 prefix.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "phone",
      "value": "+919876543210",
      "type": "string"
    },
    {
      "key": "challengeId",
      "value": "sample-challenge-id",
      "type": "string"
    },
    {
      "key": "otpCode",
      "value": "123456",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "sample-refresh-token-placeholder",
      "type": "string"
    },
    {
      "key": "vehicleId",
      "value": "11111111-1111-4111-8111-111111111111",
      "type": "string"
    },
    {
      "key": "rideId",
      "value": "22222222-2222-4222-8222-222222222222",
      "type": "string"
    },
    {
      "key": "departureTime",
      "value": "2027-01-01T08:00:00+05:30",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "health"
              ]
            },
            "description": "Returns foundation health and integration readiness."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Foundation health\", function () { pm.expect(pm.response.json()).to.eql({ status: \"ok\", phase: \"foundation\", integrationsReady: false }); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "send-otp"
              ]
            },
            "description": "Phone must use E.164 format. Identity provider is pending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 503\", function () { pm.response.to.have.status(503); });",
                  "pm.test(\"Expected error code\", function () { pm.expect(pm.response.json().code).to.eql(\"AUTH_NOT_CONFIGURED\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"code\": \"{{otpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "verify-otp"
              ]
            },
            "description": "Challenge ID: 1–200 characters; code: six digits. Placeholder values do not authenticate."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 503\", function () { pm.response.to.have.status(503); });",
                  "pm.test(\"Expected error code\", function () { pm.expect(pm.response.json().code).to.eql(\"AUTH_NOT_CONFIGURED\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Refresh token: 20–2048 characters. Session persistence is pending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 503\", function () { pm.response.to.have.status(503); });",
                  "pm.test(\"Expected error code\", function () { pm.expect(pm.response.json().code).to.eql(\"AUTH_NOT_CONFIGURED\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "No request body is required. Session persistence is pending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 503\", function () { pm.response.to.have.status(503); });",
                  "pm.test(\"Expected error code\", function () { pm.expect(pm.response.json().code).to.eql(\"AUTH_NOT_CONFIGURED\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Rides",
      "item": [
        {
          "name": "Publish ride",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"origin\": {\n    \"latitude\": 12.97,\n    \"longitude\": 77.64,\n    \"address\": \"Indiranagar\",\n    \"placeId\": \"sample-origin\"\n  },\n  \"destination\": {\n    \"latitude\": 12.96,\n    \"longitude\": 77.75,\n    \"address\": \"Whitefield\",\n    \"placeId\": \"sample-destination\"\n  },\n  \"departureTime\": \"{{departureTime}}\",\n  \"availableSeats\": 3,\n  \"contributionMinor\": 15000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/rides",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "rides"
              ]
            },
            "description": "Vehicle ID must be a UUID. Seats: 1–6. Contribution is an integer in minor currency units (0–1000000). Nested locations require latitude, longitude, address, and placeId. Departure time must be ISO 8601."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 503\", function () { pm.response.to.have.status(503); });",
                  "pm.test(\"Expected error code\", function () { pm.expect(pm.response.json().code).to.eql(\"RIDES_NOT_CONFIGURED\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Search rides",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": {\n    \"latitude\": 12.97,\n    \"longitude\": 77.64,\n    \"address\": \"Indiranagar\",\n    \"placeId\": \"sample-origin\"\n  },\n  \"destination\": {\n    \"latitude\": 12.96,\n    \"longitude\": 77.75,\n    \"address\": \"Whitefield\",\n    \"placeId\": \"sample-destination\"\n  },\n  \"departureTime\": \"{{departureTime}}\",\n  \"seats\": 1,\n  \"limit\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/rides/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "rides",
                "search"
              ]
            },
            "description": "Seats: 1–6. Optional limit: 1–100 (default 20); optional cursor: up to 200 characters. Add cursor to the JSON body when needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 503\", function () { pm.response.to.have.status(503); });",
                  "pm.test(\"Expected error code\", function () { pm.expect(pm.response.json().code).to.eql(\"RIDES_NOT_CONFIGURED\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ride details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/rides/{{rideId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "rides",
                "{{rideId}}"
              ]
            },
            "description": "Ride ID must be a UUID. Persistence and route providers are pending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 503\", function () { pm.response.to.have.status(503); });",
                  "pm.test(\"Expected error code\", function () { pm.expect(pm.response.json().code).to.eql(\"RIDES_NOT_CONFIGURED\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Validation examples",
      "item": [
        {
          "name": "Reject invalid phone",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"invalid\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "send-otp"
              ]
            },
            "description": "Phone must use E.164 format."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject unexpected auth field",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\",\n  \"verified\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "send-otp"
              ]
            },
            "description": "Global validation rejects properties absent from the DTO."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject missing locations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departureTime\": \"{{departureTime}}\",\n  \"seats\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/rides/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "rides",
                "search"
              ]
            },
            "description": "Origin and destination are required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid latitude",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": {\n    \"latitude\": 99,\n    \"longitude\": 77.64,\n    \"address\": \"Indiranagar\",\n    \"placeId\": \"sample-origin\"\n  },\n  \"destination\": {\n    \"latitude\": 12.96,\n    \"longitude\": 77.75,\n    \"address\": \"Whitefield\",\n    \"placeId\": \"sample-destination\"\n  },\n  \"departureTime\": \"{{departureTime}}\",\n  \"seats\": 1,\n  \"limit\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/rides/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "rides",
                "search"
              ]
            },
            "description": "Latitude must be between -90 and 90."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid ride ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/rides/not-a-uuid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "rides",
                "not-a-uuid"
              ]
            },
            "description": "Path parameter must be a UUID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
